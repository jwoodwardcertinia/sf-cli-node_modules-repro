# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# NOTE: `node_modules/` is deliberately NOT ignored here.
#
# The default sfdx template ignores it, but this repo exists to demonstrate
# that metadata under node_modules is dropped by source tracking without warning.
# If we ignored it here, the demo would prove nothing -- the metadata would
# be excluded by our own config rather than by the behavior under test.
#
# Only node_modules/demo-apex-pkg/sfdx-source/demo is registered as a
# packageDirectory in sfdx-project.json, so nothing else under node_modules
# is scanned.
